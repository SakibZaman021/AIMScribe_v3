# ================================================================
# AIMScribe on the UIU server - copy to .env and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is the only file on this machine with secrets in it. It is never
# committed: both AIMScribe repositories are public.
#
# Generate every password and key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ================================================================

# ---- Who this server is ----
# The name in the certificate and in every recorder's configuration.
AIMS_PUBLIC_HOST=aimscribe.uiu.ac.bd
AIMS_ACME_EMAIL=aimslab@uiu.ac.bd
TZ=Asia/Dhaka

# ---- The three kinds of disk (SRS-SRV-03) ----
# Database: mirrored NVMe with power-loss protection.
AIMS_DB_PATH=/srv/aims/db
# The archive array: RAID 6, encrypted at rest (SRS-SRV-04).
AIMS_ARCHIVE_PATH=/srv/aims/archive
# Backups: not on the database disks, and not only on this machine.
AIMS_BACKUP_PATH=/srv/aims/backups
# Space for one consultation to be downloaded, joined, compressed and
# encrypted at once. 6g suits consultations up to about two hours.
AIMS_WORK_TMPFS=6g

# ---- Database ----
POSTGRES_SUPERUSER=aims_admin
POSTGRES_SUPERUSER_PASSWORD=
# The recordings service (sessions, chains, receipts, notices).
AIMS_RECORDINGS_PASSWORD=
# The clinical service. A different role, a different database, and neither
# can reach the other's (SRS-DBA-20).
AIMS_CLINICAL_PASSWORD=
# Read-only, recordings side only. The monitor uses it.
AIMS_MONITOR_PASSWORD=

REDIS_PASSWORD=

# ---- Keys the server holds (SRS §5, SRS-REC-15) ----
# Ed25519 private keys in PEM, newlines written as \n.
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; k=K.generate(); print(k.private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode().replace(chr(10), '\\n'))"
# Signs recording grants; its public half is pinned in every installer.
AIMS_GRANT_PRIVATE_KEY=
# Signs purge receipts, which is what lets a doctor's PC delete its audio.
AIMS_RECEIPT_PRIVATE_KEY=

# ---- Credentials the server checks ----
AIMS_ADMIN_KEY=
AIMS_WORKER_KEY=
AIMSCRIBE_WEBHOOK_SECRET=
# Exact CMED origins. No wildcards.
AIMS_ALLOWED_ORIGINS=https://cmed.example

# ---- Object storage ----
# The segment store: pieces on their way from the doctors' PCs to here.
# Cloudflare R2, because the server downloads every piece and R2 charges
# nothing for that (§10.4).
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=aimscribe-audio
MINIO_SECURE=true
MINIO_REGION=auto

# The copy store: cold storage at a second provider (Glacier Deep Archive).
# Its token may write and read, never delete; the token above may delete
# pieces and cannot reach this bucket at all (SRS-ARC-12).
AIMS_COPY_BUCKET=
AIMS_COPY_ENDPOINT=s3.ap-south-1.amazonaws.com
AIMS_COPY_ACCESS_KEY=
AIMS_COPY_SECRET_KEY=
AIMS_COPY_REGION=ap-south-1
AIMS_COPY_SECURE=true

# Where the clinical JSON copies are kept warm. Unset: with the audio.
AIMS_JSON_BUCKET=
AIMS_JSON_ENDPOINT=
AIMS_JSON_ACCESS_KEY=
AIMS_JSON_SECRET_KEY=
AIMS_JSON_REGION=auto

# The key that encrypts every cloud copy. It belongs to this machine and
# is written nowhere else - not on the API, not at either provider. Keep
# one sealed offline copy: without it the copies are unreadable, by anyone.
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
AIMS_COPY_KEY=
AIMS_COPY_BATCH=2

# ---- Transcription (Azure OpenAI) ----
AZURE_TRANSCRIBE_ENDPOINT=
AZURE_TRANSCRIBE_API_KEY=
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe-diarize
AZURE_TRANSCRIBE_API_VERSION=2025-03-01-preview
AZURE_NER_ENDPOINT=
AZURE_NER_API_KEY=
AZURE_NER_DEPLOYMENT=gpt-5.2-chat
AZURE_API_VERSION=2025-01-01-preview
WORKER_CONCURRENCY=10

# Nothing clinical goes back to CMED (decision D2). Leave false.
AIMS_CMED_WEBHOOK_ENABLED=false

# ---- Backups (SRS-DAT-16) ----
AIMS_BACKUP_AT=02:30
AIMS_BACKUP_KEEP_DAYS=30
# Backups hold patients' names. Without this they are written in the clear.
AIMS_BACKUP_KEY=

# ---- Monitoring (SRS-SRV-08) ----
# Where alerts go: a chat webhook, or anything that accepts a JSON POST.
# Unset, they are in the log only - which nobody reads at 2 a.m.
AIMS_ALERT_WEBHOOK=
AIMS_MONITOR_EVERY=300
AIMS_CLINIC_HOURS=08:00-22:00
# How little may be left on each volume before it is raised.
AIMS_DISK_FLOOR_GB=500
AIMS_DB_FLOOR_GB=100
AIMS_BACKUP_FLOOR_GB=50

LOG_LEVEL=INFO
