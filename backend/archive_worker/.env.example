# AIMScribe Archive Worker - copy to .env and fill in.
#
# This process runs on the AIMS LAB server. It listens on no port and makes only
# outbound connections.

# ---- Backend ----
# Must be https in production. The worker sends no audio here, but it does send
# session and patient identifiers.
AIMS_BACKEND_URL=https://aimscribe-backend.onrender.com

# Shared secret. Must match AIMS_WORKER_KEY in the backend's environment.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AIMS_WORKER_KEY=

# Set to false only against a local backend with a self-signed certificate.
AIMS_VERIFY_TLS=true

# ---- Archive ----
# Root of the sorted tree: <root>/<HOSPITAL>/<DOCTOR>/<YYYY-MM-DD>/<file>.wav
# Should be a dedicated, encrypted volume with its own backup.
AIMS_ARCHIVE_ROOT=D:/AIMSLAB_AUDIO_STORAGE

# Refuse to start a session unless this much space would remain afterwards.
# Default 20 GB. Filling the archive volume blocks every later session.
AIMS_DISK_HEADROOM_BYTES=21474836480

# ---- Pacing ----
AIMS_POLL_SECONDS=30
AIMS_BATCH_SIZE=5
AIMS_REQUEST_TIMEOUT=60
# Large sessions take a while to pull from object storage.
AIMS_DOWNLOAD_TIMEOUT=600

AIMS_LOG_LEVEL=INFO

# ---- The cloud copy (SRS-ARC-08..13) ----
# The key that encrypts each copy before it leaves this machine. It lives here
# and nowhere else: not on the server, not in the bucket, not in the repository.
# Without it the worker archives as usual and makes no copies at all.
# Generate with:  python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Keep a sealed offline copy: losing it makes every cloud copy unreadable.
AIMS_COPY_KEY=

# How many recordings to copy in one pass. Each one is compressed, decoded
# again to prove it lossless, encrypted and uploaded, so this is the slow part.
AIMS_COPY_BATCH=2

# The copies go to cold storage (S3 Glacier Deep Archive), which is why nothing
# here ever reads one back: the server confirms each upload with the store, and
# the quarterly restore drill proves the copies usable (restore.py, AT-74).
