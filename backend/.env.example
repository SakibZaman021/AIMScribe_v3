# AIMScribe Backend - copy to .env and fill in.
#
# .env is gitignored. Never put real values in docker-compose.yml: the Neon
# password was hardcoded there and published to a public repository for three
# months before it was noticed.

# ================================================================
# PostgreSQL (Neon)
# ================================================================
POSTGRES_HOST=ep-xxxx-pooler.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# ================================================================
# Azure OpenAI
# ================================================================
AZURE_TRANSCRIBE_ENDPOINT=
AZURE_TRANSCRIBE_API_KEY=
AZURE_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe-diarize
AZURE_TRANSCRIBE_API_VERSION=2025-03-01-preview

AZURE_NER_ENDPOINT=
AZURE_NER_API_KEY=
AZURE_NER_DEPLOYMENT=gpt-5.2-chat
AZURE_API_VERSION=2025-01-01-preview

# ================================================================
# Object storage. S3-compatible: local MinIO, or Cloudflare R2.
# ================================================================
# Clips pass through here on the way to the AIMS LAB archive and are deleted
# once a verified copy exists there, so this is transit rather than storage.
#
# ---- Local MinIO (development) ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aimscribe
MINIO_SECRET_KEY=aimscribe123
MINIO_BUCKET=aimscribe-audio
MINIO_SECURE=false
MINIO_REGION=us-east-1
# Baked into every presigned URL, so it must resolve for the doctor PC and the
# AIMS LAB server. A DHCP address here breaks every in-flight URL the moment
# the machine changes network - which has already cost one session. Use a
# static address, or move to R2 and delete this line.
MINIO_EXTERNAL_ENDPOINT=192.168.1.107:9000
#
# ---- Cloudflare R2 (production) ----
# One public hostname for everyone, so there is no external endpoint to keep in
# step and no address to go stale. Create the bucket in the dashboard first: R2
# does not allow creation over the API.
#
#   MINIO_ENDPOINT=<account-id>.r2.cloudflarestorage.com
#   MINIO_ACCESS_KEY=<R2 access key id>
#   MINIO_SECRET_KEY=<R2 secret access key>
#   MINIO_BUCKET=aimscribe-audio
#   MINIO_SECURE=true
#   MINIO_REGION=auto          <- R2 requires exactly this
#   MINIO_EXTERNAL_ENDPOINT=   <- leave empty; the endpoint is already public

# ================================================================
# Protocol 2
# ================================================================
# Admin endpoints (create hospitals, mint enrollment tokens, revoke devices).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIMS_ADMIN_KEY=

# The archive worker's credential. Must match AIMS_WORKER_KEY in
# archive_worker/.env
AIMS_WORKER_KEY=

# Ed25519 private key (PKCS#8 PEM) for signing purge receipts. Without it,
# audio is still received and archived but agents never delete their local
# copies - which is the safe failure direction.
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; k=K.generate(); print(k.private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode())"
# In a .env file, put it on one line with \n escapes.
AIMS_RECEIPT_PRIVATE_KEY=

# Exact CMED origin(s). No wildcards.
AIMS_ALLOWED_ORIGINS=http://localhost:3000

# Must match AIMSCRIBE_WEBHOOK_SECRET in cmed-web.
# The old value was published in a public repo and must not be reused.
AIMSCRIBE_WEBHOOK_SECRET=

LOG_LEVEL=INFO
WORKER_CONCURRENCY=10

# ---- SRS 3.2 (v3) ----
# Ed25519 private key (PEM, newlines as \n) that signs recording grants. Its
# public half is pinned in every recorder installer. Never commit a real value.
AIMS_GRANT_PRIVATE_KEY=
# Nothing clinical goes back to CMED (decision D2). Leave false.
AIMS_CMED_WEBHOOK_ENABLED=false
# The clinical database, aims_clinical, with its own credentials (SRS-DBA-20).
# Apply scripts/clinical/*.sql to it. Unset: records go to the main database,
# with a warning at startup - never for real patient data.
AIMS_CLINICAL_DATABASE_URL=
# The copy store (SRS-STO-01): the merged lossless copy of each finished
# recording, encrypted at UIU before upload. This is cold storage - S3 Glacier
# Deep Archive, where a terabyte costs about a dollar a month and reading it
# back takes hours - because these copies exist to rebuild a lost archive, not
# to be read. Hold the objects with a lifecycle rule that moves them to
# DEEP_ARCHIVE, versioning on, and Object Lock in governance mode.
#
# It must be a different bucket from the pieces above, with its own token - and
# the token above, the one that deletes pieces, must have no access to it
# (SRS-ARC-12). Unset: no copies are kept, and pieces are deleted as soon as a
# recording is archived, as before, with a warning in the log each time.
AIMS_COPY_BUCKET=
AIMS_COPY_ENDPOINT=s3.ap-south-1.amazonaws.com
AIMS_COPY_ACCESS_KEY=
AIMS_COPY_SECRET_KEY=
AIMS_COPY_REGION=ap-south-1
AIMS_COPY_SECURE=true

# Where the clinical JSON copies go, if not with the audio. A visit's JSON is
# about two kilobytes and worth reading today rather than in twelve hours,
# while cold storage bills a minimum object size per object and answers slowly.
# So keep these warm - R2, or S3 Standard. Unset: they go to the bucket above.
AIMS_JSON_BUCKET=
AIMS_JSON_ENDPOINT=
AIMS_JSON_ACCESS_KEY=
AIMS_JSON_SECRET_KEY=
AIMS_JSON_REGION=auto
AIMS_JSON_SECURE=true
