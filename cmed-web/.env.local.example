# CMED Web - copy to .env.local, or set these in the hosting dashboard.
#
# Never commit real values. .env.local is gitignored.
#
# This app stands in for CMED's own site. In v3 it holds one secret instead of
# two: the AIMS LAB server issues recording grants now (§5), so there is no
# signing key here any more.

# ============================================================
# Channel B - this server to the AIMS LAB server (§6.2)
# ============================================================
# The key AIMS LAB issues to CMED. It lives on this server only: it is never
# sent to a browser, never in a page, never in a bundle (SRS-CHB-01, AT-72).
# Issued once with:  POST /api/v2/admin/cmed-key   - shown once, then hashed.
AIMS_CMED_KEY=

# Where API 2 and API 3 are sent. Must be https in production.
AIMS_SERVER_URL=https://aimscribe.uiu.ac.bd

# ============================================================
# Channel A - the browser to the recorder on the same PC (§6.1)
# ============================================================
# The doctor's own PC, resolved by their browser - never the server's localhost.
NEXT_PUBLIC_RECORDER_WS=ws://localhost:5050/ws

# ============================================================
# Display
# ============================================================
# A label only. The clinic a recording is filed under comes from the PC's own
# enrolment, and a mismatch is refused (CLINIC_MISMATCH, decision D1).
NEXT_PUBLIC_HOSPITAL_ID=HOSP001

# The transcription API this test app's prescription screen reads.
NEXT_PUBLIC_BACKEND_URL=https://aimscribe.uiu.ac.bd

# ============================================================
# Not used in v3
# ============================================================
# The AI webhook to CMED is switched off (decision D2), so this is only needed
# if it is ever turned back on.
AIMSCRIBE_WEBHOOK_SECRET=

# AIMS_GRANT_PRIVATE_KEY is gone: the page sends five plain fields and the
# AIMS LAB server decides (§5). If it is still set anywhere, remove it -
# /api/config-check reports it as legacy.
