# CMED Web - copy to .env.local, or set these in the Vercel dashboard.
#
# Never commit real values. .env.local is gitignored.

# ============================================================
# Doctor register
# ============================================================
# There is no doctor login. Doctors are selected from this list, which keeps
# the value a real person instead of free text - but it does not prove who is
# at the keyboard. Replace resolveDoctor() in src/lib/doctors.ts with the
# hospital identity provider when attribution has to hold up in a dispute.
#
# Format: ID:Name, comma separated. Deliberately not JSON: a stray quote in a
# hosting dashboard breaks JSON silently, and the failure looks like a login
# problem rather than a configuration one.
AIMS_DOCTORS=DR001:Dr Example,DR002:Dr Another

# ============================================================
# Recording grants (the agent will not record without these)
# ============================================================
# Ed25519 private key, PKCS#8 PEM. The public half goes on every doctor PC at
#   C:\ProgramData\AIMScribe\keys\cmed_grant_pub.pem
#
# Generate both halves:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}));console.log(publicKey.export({type:'spki',format:'pem'}))"
#
# In Vercel, paste the PEM with real newlines. In a .env file, use 
 escapes.
AIMS_GRANT_PRIVATE_KEY=

# Must match AIMS_GRANT_ISSUER / AIMS_GRANT_AUDIENCE in each agent .env
AIMS_GRANT_ISSUER=cmed
AIMS_GRANT_AUDIENCE=aimscribe-recorder

# ============================================================
# Backend
# ============================================================
NEXT_PUBLIC_BACKEND_URL=https://aimscribe-backend-render.onrender.com

# Must match AIMSCRIBE_WEBHOOK_SECRET in the backend. Unsigned NER webhooks are
# rejected, so this is required for prescription fields to populate.
AIMSCRIBE_WEBHOOK_SECRET=

# ============================================================
# Display
# ============================================================
# Shown on the dashboard. The agent cross-checks the grant hospital against the
# one its device was enrolled at and refuses a mismatch, so this is a label and
# not a decision.
NEXT_PUBLIC_HOSPITAL_ID=HOSP001

# The doctor own PC, resolved by their browser - never the server localhost.
NEXT_PUBLIC_RECORDER_WS=ws://localhost:5050/ws
