# AIMScribe Recorder â€” configuration template
# Copy to .env next to the executable. Values here are read at startup only.
#
# SECRETS: this file holds the local API key and file paths, not private keys.
# Private keys live in %PROGRAMDATA%\AIMScribe\keys and are wrapped with Windows DPAPI.

# ============================================================
# Backend (AIMS LAB server)
# ============================================================
# Reached over the per-PC tunnel. Must be https in production.
AIMS_BACKEND_URL=https://aimslab.internal
AIMS_BACKEND_API_PREFIX=/api/v2
AIMS_REQUEST_TIMEOUT=30
AIMS_UPLOAD_TIMEOUT=300
# Retry backoff for uploads, seconds, comma separated. Segments are never dropped.
AIMS_RETRY_BACKOFF=2,8,30,120,600

# Client certificate for mTLS. Issued during enrollment.
AIMS_CLIENT_CERT_PATH=
AIMS_CLIENT_KEY_PATH=
# Pin the server. Leave blank to use the Windows trust store.
AIMS_CA_BUNDLE_PATH=

# ============================================================
# Audio â€” WAV PCM. Changing these changes the archive contract.
# ============================================================
AIMS_SAMPLE_RATE=44100
AIMS_CHANNELS=1
AIMS_SAMPLE_WIDTH=2
# Frames per callback. 2048 at 44.1 kHz is ~46 ms; larger means less CPU wakeup.
AIMS_FRAMES_PER_BUFFER=2048
# Blank uses the Windows default input device.
AIMS_INPUT_DEVICE_INDEX=

# ============================================================
# Segmenting â€” clips stream as they are produced
# ============================================================
AIMS_SEGMENT_MIN_SECONDS=170
AIMS_SEGMENT_MAX_SECONDS=190
# Linear RMS on a 0-32767 scale. 320 is about -40 dBFS.
AIMS_SILENCE_RMS=320
AIMS_SILENCE_HOLD_SECONDS=1.0

# ============================================================
# Spool â€” the local store-and-forward buffer
# ============================================================
# Blank uses %PROGRAMDATA%\AIMScribe\spool
AIMS_SPOOL_DIR=
# 40 GB buys about three weeks of backend downtime at 44.1 kHz.
AIMS_SPOOL_MAX_BYTES=42949672960
AIMS_SPOOL_WARN_RATIO=0.5
AIMS_SPOOL_CRITICAL_RATIO=0.8
# Keep purge-receipted segments this long as a safety net before deleting.
AIMS_PURGE_GRACE_HOURS=24

# ============================================================
# Local control plane â€” who may drive this recorder
# ============================================================
AIMS_BIND_HOST=127.0.0.1
AIMS_BIND_PORT=5050
# Exact origins only. No wildcards, no null. Comma separated.
AIMS_ALLOWED_ORIGINS=https://cmed.aimslab.example,http://localhost:3000
# Host header allowlist, blocks DNS rebinding.
AIMS_ALLOWED_HOSTS=localhost:5050,127.0.0.1:5050,[::1]:5050
# Shared secret for the local HTTP API. Generated per install by the installer.
AIMS_LOCAL_API_KEY=change-me-per-install
# Require a CMED-signed grant before recording. Never disable in production.
AIMS_REQUIRE_GRANT=true
# Serve /docs and /redoc. Off in production.
AIMS_ENABLE_DOCS=false

# ============================================================
# Pinned public keys (PEM). Blank paths resolve under %PROGRAMDATA%\AIMScribe\keys
# ============================================================
# Verifies recording grants minted by CMED's server.
AIMS_GRANT_PUBLIC_KEY_PATH=
AIMS_GRANT_ISSUER=cmed
AIMS_GRANT_AUDIENCE=aimscribe-recorder
# Verifies purge receipts from the AIMS LAB server before any local deletion.
AIMS_RECEIPT_PUBLIC_KEY_PATH=

# ============================================================
# Supervised pause
# ============================================================
# A doctor may pause alone up to this long; beyond it a supervisor must approve.
AIMS_PAUSE_SELF_AUTHORISE_SECONDS=300

# ============================================================
# Operations
# ============================================================
AIMS_HEARTBEAT_SECONDS=30
AIMS_LOG_LEVEL=INFO
AIMS_LOG_RETENTION_DAYS=30
# Hash patient and doctor identifiers in log files.
AIMS_REDACT_LOGS=true
# Development escape hatch. Never true on a clinical PC.
AIMS_ALLOW_PLAINTEXT_KEYSTORE=false
